<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <main>
      <section class="page-hero">
        <div class="container narrow">
          <p class="eyebrow">Contact</p>
          <h1>Get in touch</h1>
          <p class="lead">
            Have a question, a challenge, or a project in mind? We'd like to hear from you.
            Reach out and we'll respond as soon as possible.
          </p>
        </div>
      </section>

      <section class="section">
        <div class="container contact-grid">
          <div class="contact-info">
            <h2>Contact Information</h2>
            <ul class="contact-details">
              <li>
                <span class="contact-label">Email</span>
                <a href="mailto:taig2k@outlook.com">taig2k@outlook.com</a>
              </li>
              <li>
                <span class="contact-label">Phone</span>
                <a href="tel:+19049161460">(904) 916-1460</a>
              </li>
              <li>
                <span class="contact-label">Based in</span>
                <span>Jacksonville, FL</span>
              </li>
              <li>
                <span class="contact-label">Response Time</span>
                <span>Within one business day</span>
              </li>
              <li>
                <span class="contact-label">Best For</span>
                <span>General inquiries, service questions, and initial consultations</span>
              </li>
            </ul>
            <p class="contact-note">
              Prefer to start with context? Use the form to tell us briefly about your situation —
              we'll follow up to schedule a conversation.
            </p>
          </div>

          <div class="contact-form-wrapper">
            <h2>Send a Message</h2>
            <% if (typeof success !== 'undefined' && success) { %>
              <p class="form-success" role="status">Thanks — your message was received. We will get back to you within one business day.</p>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
              <p class="form-error" role="alert"><%= error %></p>
            <% } %>
            <form class="contact-form" action="/contact" method="post">
              <div class="form-group">
                <label for="name">Full Name <span class="required" aria-hidden="true">*</span></label>
                <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your full name" value="<%= typeof form !== 'undefined' && form.name ? form.name : '' %>" />
              </div>
              <div class="form-group">
                <label for="email">Email <span class="required" aria-hidden="true">*</span></label>
                <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@company.com" value="<%= typeof form !== 'undefined' && form.email ? form.email : '' %>" />
              </div>
              <div class="form-group">
                <label for="phone">Phone <span class="required" aria-hidden="true">*</span></label>
                <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="(904) 555-0100" value="<%= typeof form !== 'undefined' && form.phone ? form.phone : '' %>" />
              </div>
              <div class="form-group">
                <label for="company">Company</label>
                <input type="text" id="company" name="company" autocomplete="organization" placeholder="Your organization (optional)" value="<%= typeof form !== 'undefined' && form.company ? form.company : '' %>" />
              </div>
              <div class="form-group">
                <label for="subject">Subject</label>
                <select id="subject" name="subject">
                  <option value="">Pick a subject</option>
                  <option value="business-refresh">Business Operation Refresh</option>
                  <option value="monthly-cover">Monthly IT Cover</option>
                  <option value="websites">Websites Built and Looked After</option>
                  <option value="social-media">Social Media, Managed for You</option>
                  <option value="marketing">Marketing and Promotion</option>
                  <option value="pc-repair-sales">Computer Repair and Sales</option>
                  <option value="something-else">Something else</option>
                  <option value="general">General question</option>
                </select>
              </div>
              <div class="form-group">
                <label for="message">Project Background</label>
                <textarea id="message" name="message" rows="5" placeholder="Tell us about your situation or question... (optional)"><%= typeof form !== 'undefined' && form.message ? form.message : '' %></textarea>
              </div>
              <div class="form-group">
                <label for="timeline">Timeline (optional)</label>
                <select id="timeline" name="timeline">
                  <option value="">Just exploring</option>
                  <option value="this-month">This month</option>
                  <option value="next-few-months">Next few months</option>
                  <option value="flexible">Flexible</option>
                </select>
              </div>
              <div class="form-group">
                <label for="budget">Rough Budget (optional)</label>
                <select id="budget" name="budget">
                  <option value="">Prefer to discuss</option>
                  <option value="under-500">Under $500</option>
                  <option value="500-2000">$500 - $2,000</option>
                  <option value="over-2000">Over $2,000</option>
                </select>
              </div>
              <div class="form-group">
                <label><input type="checkbox" name="smsConsent" /> It is OK to text me about this inquiry.</label>
              </div>
              <button type="submit" class="btn btn-primary btn-full">Send Message</button>
            </form>
          </div>
        </div>
      </section>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
